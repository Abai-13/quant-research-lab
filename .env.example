# 复制为 .env 后按需修改。此文件不含任何密钥，仅为本地默认值。
# 相对路径以项目根目录为基准；未设置的项使用代码内默认值。

# 后端监听地址。阶段 1 无登录保护，请保持回环地址。
APP_BACKEND_HOST=127.0.0.1
APP_BACKEND_PORT=8000
APP_FRONTEND_PORT=5173

# 可选：运行目录（数据库、日志、进程记录）。默认 <项目根>/.runtime
# APP_RUNTIME_DIR=
# 可选：数据库文件路径。默认 <运行目录>/data/app.db
# APP_DB_PATH=
# 可选：日志目录。默认 <运行目录>/logs
# APP_LOG_DIR=
