# 复制为 .env 后按需修改。此文件不含任何密钥，仅为本地默认值。
# 相对路径以项目根目录为基准；未设置的项使用代码内默认值。

# 后端监听地址。阶段 1 无登录保护，请保持回环地址。
APP_BACKEND_HOST=127.0.0.1
APP_BACKEND_PORT=8000
APP_FRONTEND_PORT=5173

# 可选：运行目录（数据库、日志、进程记录）。默认 <项目根>/.runtime
# APP_RUNTIME_DIR=
# 可选：数据库文件路径。默认 <运行目录>/data/app.db
# APP_DB_PATH=
# 可选：日志目录。默认 <运行目录>/logs
# APP_LOG_DIR=
# 可选：迁移前一致性备份目录。默认 <运行目录>/backups
# APP_BACKUP_DIR=
# 可选：原始响应档案目录。默认 <运行目录>/data/raw
# APP_DATA_RAW_DIR=
# 可选：数据写入锁目录。默认 <运行目录>/locks
# APP_LOCK_DIR=

# ---------------------------------------------------------------------------
# 阶段 2：数据接入
# ---------------------------------------------------------------------------

# 数据来源：tushare（真实接口，需要凭据）或 tushare-fixture（离线夹具，仅测试与演示）
APP_DATA_SOURCE=tushare

# Tushare 接口地址（官方通用接口）
APP_TUSHARE_API_URL=https://api.tushare.pro

# Tushare 令牌：把真实令牌写在自己的 .env 里，不要提交到版本库。
# 未配置时真实导入会被明确拒绝，离线夹具模式不受影响。
# APP_TUSHARE_TOKEN=

# 离线夹具目录（仅当 APP_DATA_SOURCE=tushare-fixture 时使用）
# APP_DATA_FIXTURE_DIR=backend/tests/fixtures/tushare

# 导入重试与限频边界（有界，不会随结果放宽）
# APP_IMPORT_MAX_ATTEMPTS=3
# APP_IMPORT_BACKOFF_SECONDS=1,3
# APP_IMPORT_PAGE_WAIT_BUDGET=60
# APP_IMPORT_BATCH_WAIT_BUDGET=600
# APP_IMPORT_MIN_INTERVAL_SECONDS=0.35
# APP_IMPORT_TIMEOUT_SECONDS=30
# APP_IMPORT_REVISION_WINDOW_DAYS=5
# APP_IMPORT_MAX_PAGES=200
# APP_IMPORT_LOCK_WAIT_SECONDS=30
